# Convex (set by `npx convex dev` in .env.local)
CONVEX_DEPLOYMENT=dev:your-deployment-name
CONVEX_DEPLOY_KEY=your-deploy-key
CONVEX_URL=https://your-deployment.convex.cloud
# UI needs this (Vite exposes only VITE_* to client). Copy CONVEX_URL here after convex dev.
VITE_CONVEX_URL=https://your-deployment.convex.cloud

# Human authentication rollout. Omit to preserve the existing legacy provider;
# select `clerk` only after configuring both values below. `demo` is local-only.
VITE_AUTH_MODE=legacy
# VITE_CLERK_PUBLISHABLE_KEY=pk_test_your_publishable_key
# Replace the public placeholder in convex/auth.config.ts with the Clerk issuer
# when enabling Clerk. Convex requires auth-config env vars before compilation.
# One-time initial-owner recovery; remove both after bootstrap succeeds.
# Set these on the Convex deployment, not in Vite.
# MC_BOOTSTRAP_OWNER_SUBJECT=user_your_exact_clerk_user_id
# MC_BOOTSTRAP_TENANT_SLUG=your-company-slug
# ARM/legacy compatibility mode (true = legacy-pref reads, false = ARM instance-pref reads)
ARM_COMPAT_MODE=true

# API Server
API_PORT=3000
API_SECRET=your-api-secret-change-in-production
NODE_ENV=development

# Workers
WORKER_CONCURRENCY=5
HEARTBEAT_INTERVAL_MS=30000
LOOP_DETECTION_INTERVAL_MS=60000

# Orchestration server (optional; when set, /status, /tick, /agents/*, /gateway/status require Bearer token)
ORCHESTRATION_PORT=4100
ORCHESTRATION_API_TOKEN=
# MC_API_TOKEN=  # alternative to ORCHESTRATION_API_TOKEN

# OpenClaw Gateway (URL can also be set in UI Gateway settings; token server-side only)
OPENCLAW_GATEWAY_URL=http://localhost:8080
GATEWAY_TOKEN=
# Convex env for discovery: set OPENCLAW_GATEWAY_TOKEN or GATEWAY_TOKEN to match

# Heartbeat recovery (Convex dashboard env). When set, stale-heartbeat cron runs.
# HEARTBEAT_RECOVERY_ENABLED=true
# HEARTBEAT_STALE_MINUTES=5
# HEARTBEAT_IGNORE_NEVER=true   # Skip agents that have never sent a heartbeat

# Telegram
TELEGRAM_BOT_TOKEN=your-telegram-bot-token

# Slack (optional)
SLACK_BOT_TOKEN=your-slack-bot-token
SLACK_SIGNING_SECRET=your-slack-signing-secret

# Monitoring (optional)
SENTRY_DSN=
LOG_LEVEL=info

# Budget Defaults (USD)
DEFAULT_INTERN_DAILY_BUDGET=2
DEFAULT_SPECIALIST_DAILY_BUDGET=5
DEFAULT_LEAD_DAILY_BUDGET=12
